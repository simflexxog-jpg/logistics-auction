NODE_ENV=development
PORT=3000
# DATABASE_URL=postgresql://logi_user:logi_pass@localhost:5432/logistics_auction
JWT_SECRET=dev_secret_key_change_in_production
FRONTEND_URL=http://localhost:4200
API_URL=http://localhost:3000

# Admin onboarding secret (use a strong random value)
ADMIN_SECRET=Renta_Admin_Secret_2004


# SMTP (optional) - required for admin notify emails
# Example: SMTP_HOST=smtp.sendgrid.net
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@yourdomain.com

# Google OAuth (optional) - configure to enable "Sign in with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
